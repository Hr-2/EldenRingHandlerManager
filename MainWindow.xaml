<Window x:Class="ERHandlerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Elden Ring Handler Manager"
        Width="1000" Height="640"
        MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="#FFFFFFFF"
        FontFamily="Segoe UI"
        TextElement.FontSize="12"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Engine tab (ME2 / ME3) -->
        <Style x:Key="EngineTab" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================= TITLE BAR ======================= -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="Elden Ring Handler Manager" Foreground="{StaticResource DimTextBrush}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click"/>
                    <Button Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="Maximize_Click"/>
                    <Button Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= SIDEBAR ======================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <!-- App title -->
                <StackPanel DockPanel.Dock="Top" Margin="2,0,0,20">
                    <TextBlock Text="Elden Ring" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Handler Manager" FontSize="12" Foreground="{StaticResource DimTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top">
                    <ToggleButton x:Name="NavMods" Style="{StaticResource NavButton}" Margin="0,0,0,6" IsChecked="True"
                                  Click="Nav_Click" Tag="Mods">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Mods" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="NavDeploy" Style="{StaticResource NavButton}" Margin="0,0,0,6"
                                  Click="Nav_Click" Tag="Deploy">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Deploy" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="NavHandlers" Style="{StaticResource NavButton}"
                                  Click="Nav_Click" Tag="Handlers">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Handlers" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border x:Name="EngineBadge" Background="#2A28A745" CornerRadius="8" Padding="10,6">
                        <StackPanel>
                            <TextBlock Text="Active engine" FontSize="9" Foreground="{StaticResource DimTextBrush}"/>
                            <TextBlock x:Name="EngineBadgeText" Text="ME3" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="UpdateBtn" Content="Check for updates" Style="{StaticResource GhostButton}"
                            Padding="10,6" Margin="0,10,0,0" Click="CheckForUpdate_Click">
                        <Button.ToolTip>Check for a new release on GitHub</Button.ToolTip>
                    </Button>
                    <TextBlock x:Name="UpdateStatusText" Text="" Foreground="{StaticResource DimTextBrush}"
                               FontSize="9.5" TextWrapping="Wrap" Margin="2,6,0,0"/>
                    <TextBlock Text="Only touches the Nucleus handlers folder. No game path needed."
                               Foreground="#66FFFFFF" FontSize="9.5" TextWrapping="Wrap" Margin="2,10,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======================= CONTENT ======================= -->
        <Grid Grid.Column="1" Margin="20,18,20,18">
            <!-- ====================== MODS PAGE ====================== -->
            <Grid x:Name="PageMods" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mods" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            <Border x:Name="ModCountBadge" Background="#FF3D3D3D" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ModCountText" Text="0" Foreground="#FF9B9B9B" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2" Background="{StaticResource PanelBrush}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="TabME2" Content="ME2 handler" Style="{StaticResource EngineTab}"
                                              IsChecked="True" Click="EngineTab_Click" Tag="ME2"/>
                                <ToggleButton x:Name="TabME3" Content="ME3 handler" Style="{StaticResource EngineTab}"
                                              Margin="2,0,0,0" Click="EngineTab_Click" Tag="ME3"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Showing mods for the selected engine. Drop folders or .dll files to add them."
                                   Foreground="{StaticResource DimTextBrush}" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <!-- Profiles -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Profile:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="ProfileCombo" Style="{StaticResource DarkComboBox}" Width="180"
                                  Margin="8,0,0,0" VerticalAlignment="Center"
                                  SelectionChanged="ProfileCombo_SelectionChanged"/>
                        <Button Content="Load" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                VerticalAlignment="Center" Padding="10,4" Click="ProfileLoad_Click"/>
                        <Button Content="Save" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                VerticalAlignment="Center" Padding="10,4" Click="ProfileSave_Click"/>
                        <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="4,0,0,0"
                                VerticalAlignment="Center" Padding="10,4" Click="ProfileDelete_Click"/>
                        <CheckBox x:Name="ChkAutoSave" Content="Auto-save mods on change" Style="{StaticResource DarkCheckBox}"
                                  VerticalAlignment="Center" Margin="16,0,0,0"
                                  Checked="AutoSave_Toggled" Unchecked="AutoSave_Toggled"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+  Add mod" Style="{StaticResource PrimaryButton}" Click="AddMod_Click"/>
                        <Button Content="Edit" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="EditMod_Click"/>
                        <Button Content="Remove" Style="{StaticResource DangerButton}" Margin="6,0,0,0" Click="RemoveMod_Click"/>
                        <TextBlock Text="Drop folders or .dll files here to add them automatically."
                                   Foreground="{StaticResource DimTextBrush}" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>

                    <!-- Mod tree -->
                    <Border Grid.Row="1" x:Name="ModListDropZone" CornerRadius="10"
                            BorderBrush="Transparent" BorderThickness="2"
                            Background="#0AFFFFFF">
                        <TreeView x:Name="ModList" Background="Transparent" BorderThickness="0"
                                  Foreground="#FFFFFFFF" FontSize="11"
                                  AllowDrop="True"
                                  DragEnter="ModList_DragOver" DragOver="ModList_DragOver"
                                  DragLeave="ModList_DragLeave" Drop="ModList_Drop">
                        <TreeView.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Border x:Name="Bd" CornerRadius="8"
                                                        Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"
                                                        Padding="0,7" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <ToggleButton x:Name="Expander" Width="30" Height="30"
                                                                      ClickMode="Press" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                      Cursor="Hand"
                                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent" CornerRadius="6">
                                                                        <Path x:Name="Arrow" Data="M 0 0 L 7 7 L 14 0 Z" Fill="#FFB3B3B3"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                              RenderTransformOrigin="0.5,0.5" Margin="2">
                                                                            <Path.RenderTransform>
                                                                                <RotateTransform Angle="0"/>
                                                                            </Path.RenderTransform>
                                                                        </Path>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="90"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Arrow" Property="Fill" Value="White"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>

                                                        <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                                          HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1"
                                                                Margin="14,0,0,0"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsContainer}" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#550078D4"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>

                        <TreeView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </TreeView.ItemsPanel>

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon: folder = folder mod, dll = dll mod -->
                                    <Grid Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Opacity" Value="0.35"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <!-- Windows-style folder -->
                                        <Path x:Name="FolderIcon" Data="M 2,7 L 2,20 L 26,20 L 26,10 L 13,10 L 11,7 Z"
                                              Fill="#FFE8A33D" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Width="24" Height="20" Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Dll">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <!-- Windows-style DLL file -->
                                        <Grid x:Name="DllIcon" Width="22" Height="24"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Dll">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Path Data="M 2,1 L 13,1 L 20,8 L 20,22 L 2,22 Z" Fill="#FF4FC3F7"/>
                                            <Path Data="M 13,1 L 13,8 L 20,8 Z" Fill="#FF9B9B9B"/>
                                            <Path Data="M 9,11 L 15,11 L 15,13 L 9,13 Z" Fill="#FF1E1E1E"/>
                                            <Path Data="M 9,15 L 15,15 L 15,17 L 9,17 Z" Fill="#FF1E1E1E"/>
                                        </Grid>
                                    </Grid>

                                    <!-- Name + tags -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button x:Name="ModTag" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                    Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Cursor="Hand" ToolTip="Is this folder a mod? Mark mods so they're counted and deployed."
                                                    Click="IsMod_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="&#xE734;"/>
                                                        <Setter Property="Foreground" Value="#FF9B9B9B"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMod}" Value="True">
                                                                <Setter Property="Content" Value="&#xE735;"/>
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Border x:Name="KindTag" Background="#3328A745" CornerRadius="6" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="9" Foreground="#FF9BFFB0" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#33FFA500" CornerRadius="6" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HandlerJsPath}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HandlerJsPath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasHandlerJs}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="custom JS" FontSize="9" Foreground="#FFFFC107" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#330078D4" CornerRadius="6" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDlls}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="DLLs inside" FontSize="9" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SourcePath}" Foreground="{StaticResource DimTextBrush}"
                                                   FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding DllInfo}" Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="8.5" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Toggle switch (hidden for nested folders; they're loaded with their parent) -->
                                    <CheckBox Grid.Column="2" Style="{StaticResource ModToggle}"
                                              VerticalAlignment="Center" Margin="12,0,0,0"
                                              IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Click="ModToggle_Changed">
                                        <CheckBox.Visibility>
                                            <Binding Path="ShowToggle">
                                                <Binding.Converter>
                                                    <BooleanToVisibilityConverter/>
                                                </Binding.Converter>
                                            </Binding>
                                        </CheckBox.Visibility>
                                    </CheckBox>

                                    <!-- Open folder button -->
                                    <Button Grid.Column="3" Content="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Style="{StaticResource GhostButton}" Padding="8,4" Margin="8,0,0,0"
                                            ToolTip="Open mod folder in Explorer" Click="OpenModFolder_Click"/>

                                    <!-- Edit button -->
                                    <Button Grid.Column="4" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Style="{StaticResource GhostButton}" Padding="8,4" Margin="8,0,0,0"
                                            ToolTip="Edit mod details" Click="EditMod_Click"/>

                                    <!-- Remove button -->
                                    <Button Grid.Column="5" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Style="{StaticResource GhostButton}" Padding="8,4" Margin="8,0,0,0"
                                            ToolTip="Remove from list" Click="RemoveMod_Click"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="2" x:Name="ModsStatus" Foreground="{StaticResource DimTextBrush}"
                           FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </Grid>

            <!-- ====================== DEPLOY PAGE ====================== -->
            <Grid x:Name="PageDeploy" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Deploy" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Build the active Nucleus handler from your base template, enabled mods, and generated config."
                               Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Pick the engine you want to deploy. Enabling a mod on one tab auto-disables the other tab's mods."
                               Foreground="{StaticResource DimTextBrush}" FontSize="10.5" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource DangerButton}" FontSize="12" Padding="14,8"
                                Margin="0,0,8,0" Visibility="Collapsed" Click="CancelBtn_Click"/>
                        <Button x:Name="BackupBtn" Content="Backup" FontSize="12" Padding="14,8"
                                Margin="0,0,8,0" ToolTip="Save a copy of the current deployed handler" Click="Backup_Click"
                                Foreground="#FF28A745" BorderBrush="#5528A745" Background="#1A28A745">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Foreground" Value="#FF28A745"/>
                                    <Setter Property="BorderBrush" Value="#5528A745"/>
                                    <Setter Property="Background" Value="#1A28A745"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#4A28A745"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="DeployME2Btn" Content="Deploy ME2" Style="{StaticResource DangerButton}" FontSize="12" Padding="16,8"
                                Margin="0,0,8,0" Click="DeployME2_Click"/>
                        <Button x:Name="DeployME3Btn" Content="Deploy ME3" Style="{StaticResource PrimaryButton}" FontSize="12" Padding="16,8" Click="DeployME3_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="DeploySummary" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Auto-configure config file" Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkAutoConfig" Style="{StaticResource ModToggle}" Margin="10,0,0,0"
                                  VerticalAlignment="Center" Checked="AutoConfig_Toggled" Unchecked="AutoConfig_Toggled"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="4" Background="#FF141414" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,6,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="10,8,10,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="DeployProgress" Height="6" Minimum="0" Maximum="100"
                                         Background="#FF2D2D2D" Foreground="{StaticResource AccentBrush}"
                                         BorderThickness="0"/>
                            <TextBlock x:Name="DeployProgressText" Grid.Column="1" Text=""
                                       Foreground="{StaticResource DimTextBrush}" FontSize="10"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBox x:Name="LogBox" Grid.Row="1" Background="Transparent" Foreground="#FFCCCCCC"
                                 FontFamily="Consolas" FontSize="10.5" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 BorderThickness="0" Padding="10,4,10,8" TextWrapping="NoWrap">
                            <TextBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="5" Foreground="{StaticResource DimTextBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap">
                    <Run Text="Copies base handler (.js + folder) into the Nucleus handlers folder, drops enabled mods into ModEngine, and writes config_eldenring.toml (ME2) or me3.toml (ME3) when auto-configure is on. Use Backup to save a copy of the current deployed handler."/>
                </TextBlock>
            </Grid>

            <!-- ====================== HANDLERS PAGE ====================== -->
            <Grid x:Name="PageHandlers" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Handlers" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Paths used by Deploy. Base templates are the clean starting points for each engine."
                                       Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Nucleus paths" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                                <Label Content="Nucleus handlers folder" Style="{StaticResource DarkLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtHandlersDir" Style="{StaticResource DarkTextBox}"/>
                                    <Button Grid.Column="1" Content="Open" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                            ToolTip="Open in Explorer" Click="OpenHandlersFolder_Click"/>
                                    <Button Grid.Column="2" Content="Browse..." Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="BrowseHandlersDir_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Base handler templates" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Tip: you can find these handlers in vlxst.'s Elden Ring thread on the Nucleus Co-Op Discord server."
                                           Foreground="{StaticResource WarningBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Label Content="ME2 UNOFFICIAL HANDLER (vlxst.)" Style="{StaticResource DarkLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtMe2Base" Style="{StaticResource DarkTextBox}"/>
                                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="BrowseBase_Click" Tag="ME2"/>
                                </Grid>

                                <Label Content="ME3 UNOFFICIAL HANDLER (vlxst.)" Style="{StaticResource DarkLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtMe3Base" Style="{StaticResource DarkTextBox}"/>
                                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="BrowseBase_Click" Tag="ME3"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>