<Window x:Class="ERHandlerManager.ProfileNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save profile"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="#FFFFFFFF"
        FontFamily="Segoe UI"
        TextElement.FontSize="12">
    <StackPanel Margin="18,16,18,16">
        <TextBlock Text="Profile name" Style="{StaticResource SectionHeader}"/>
        <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBox}" KeyDown="TxtName_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Padding="18,6"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Padding="18,6" Margin="10,0,0,0" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>