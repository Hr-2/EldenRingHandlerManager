<Window x:Class="ERHandlerManager.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="#FFFFFFFF"
        FontFamily="Segoe UI"
        TextElement.FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Foreground="{StaticResource DimTextBrush}"
                           FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,16,20,16">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5"/>
            <CheckBox x:Name="ChkDontAskAgain" Content="Don't ask me again"
                      Style="{StaticResource DarkCheckBox}" Margin="0,16,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Padding="18,6"/>
                <Button Content="Yes" Style="{StaticResource PrimaryButton}" Padding="18,6"
                        Margin="10,0,0,0" Click="Yes_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
