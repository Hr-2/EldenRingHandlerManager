<Window x:Class="ERHandlerManager.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changelog"
        Width="560" Height="560"
        MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="#FFFFFFFF"
        FontFamily="Segoe UI"
        TextElement.FontSize="12"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="Changelog" Foreground="{StaticResource DimTextBrush}"
                           FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>
        </Border>

        <!-- Content -->
        <TextBox Grid.Row="1" x:Name="ChangelogText" Background="#FF141414" Foreground="#FFCCCCCC"
                 FontFamily="Consolas" FontSize="10.5" IsReadOnly="True" BorderThickness="0"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Padding="14,10" TextWrapping="NoWrap">
            <TextBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
            </TextBox.Resources>
        </TextBox>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <TextBlock x:Name="VersionHint" Text="" Foreground="{StaticResource DimTextBrush}"
                           FontSize="10" VerticalAlignment="Center"/>
                <Button Content="Close" Style="{StaticResource PrimaryButton}" Padding="18,6"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
